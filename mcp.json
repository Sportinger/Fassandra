{
  "mcpServers": {
    "playwright-vision": {
      "command": "npx",
      "args": [
        "@playwright/mcp",
        "--vision"
      ]
    },
    "playwright-test": {
      "command": "npx",
      "args": [
        "@playwright/mcp"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "@modelcontextprotocol/server-filesystem",
        "/"
      ]
    },
    "database": {
      "command": "npx",
      "args": [
        "-y",
        "@ahmetbarut/mcp-database-server"
      ],
      "env": {
        "DATABASE_CONNECTIONS": "pessoa_db=postgresql://pessoa_user:dev_password_123@localhost:5432/pessoa_db"
      }
    },
    "puppeteer": {
      "command": "npx",
      "args": ["-y", "@hisma/server-puppeteer"],
      "env": {
        "PUPPETEER_HEADLESS": "false"
      }
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "chrome-debug": {
      "command": "npx",
      "args": ["-y", "chrome-debug-mcp-playwright"]
    },
    "ElevenLabs": {
      "command": "uvx",
      "args": ["elevenlabs-mcp"],
      "env": {
        "ELEVENLABS_API_KEY": "sk_4972eb0e2ba025c29afc4c1eab48076e94930a99df9718c0"
      }
    }
  }
} 