# 🌐 DOMAIN CONFIGURATION (Your working setup)
APP_HOSTNAME=mylayer.org
BACKEND_PORT=3001
FRONTEND_PORT=8080          # HTTP port (redirects to HTTPS)
FRONTEND_HTTPS_PORT=8443    # HTTPS port (your working setup)
DB_PORT=5433
CONTAINER_PREFIX=main_      # Your existing prefix

# 🐳 GITHUB ACTIONS DEPLOYMENT CONFIGURATION
# Add these for GitHub Actions deployment:
DOCKER_REGISTRY=ghcr.io/sportinger  # Your GitHub username
IMAGE_TAG=latest

# 🔐 SSL CERTIFICATES (Your working paths)
# Update these paths to match your Hetzner server:
SSL_CERT_PATH=/etc/ssl/certs/mylayer.org.crt
SSL_KEY_PATH=/etc/ssl/private/mylayer.org.key

