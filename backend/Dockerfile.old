# --- Builder Stage --- 
FROM rust:1.82-slim AS builder
WORKDIR /app

# Install build dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential pkg-config libssl-dev ca-certificates lld && \
    rm -rf /var/lib/apt/lists/*

# Copy helper scripts
COPY helper/bash/cargo_speed.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/cargo_speed.sh

# Set up cargo speed optimizations
ENV CARGO_HOME=/usr/local/cargo
ENV CARGO_TARGET_DIR=/tmp/cargo-target
ENV RUSTFLAGS="-C link-arg=-fuse-ld=lld"
ENV CARGO_INCREMENTAL=1
ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse

# Copy dependency definitions (now relative to project root)
COPY backend/Cargo.toml /app/
COPY backend/Cargo.lock /app/
COPY backend/.sqlx /app/.sqlx
COPY backend/scripts /app/scripts

# Create dummy source file to cache dependencies
WORKDIR /app
RUN mkdir src && \
    echo "fn main() {}" > src/lib.rs && \
    # Build only dependencies
    /usr/local/bin/cargo_speed.sh && cargo fetch

# Copy actual source code and migrations (now relative to project root)
COPY backend/src /app/src
COPY backend/migrations /app/migrations

# Clean target before final build (to rule out cache issues)
RUN rm -rf /tmp/cargo-target

# Build the application, using cached dependencies
RUN touch src/lib.rs && \
    /usr/local/bin/cargo_speed.sh cargo build --release

# --- Final Stage --- 
FROM debian:bookworm-slim

WORKDIR /app

# Create a non-root user and group
RUN groupadd -r appuser && useradd -r -g appuser -d /app -s /sbin/nologin -c "Docker image user" appuser

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends libssl3 ca-certificates && rm -rf /var/lib/apt/lists/*

# Copy migrations required at runtime (now relative to project root)
COPY backend/migrations /app/migrations

# Copy the compiled binary from the builder stage
COPY --from=builder /tmp/cargo-target/release/backend /usr/local/bin/backend

# Change ownership to non-root user
RUN chown -R appuser:appuser /app && \
    chown appuser:appuser /usr/local/bin/backend

# Switch to non-root user
USER appuser

# Expose the port the application listens on (already handled by docker-compose)
EXPOSE 3001

# Set the entrypoint
CMD ["backend"]
