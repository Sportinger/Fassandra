{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT DISTINCT s.* FROM scripts s\n        WHERE s.created_by = $1\n           OR s.is_public = true\n           OR EXISTS (\n               SELECT 1 FROM script_shares ss \n               WHERE ss.script_id = s.id \n               AND ss.shared_with_user_id = $1\n           )\n        ORDER BY s.created_at DESC\n        ",
