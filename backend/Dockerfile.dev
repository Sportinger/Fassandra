# Development Dockerfile with Hot Reload Support
FROM rust:1.82.0-slim-bullseye AS development

# Set development environment
ENV CARGO_HOME=/usr/local/cargo
ENV RUSTFLAGS="-C link-arg=-fuse-ld=lld"
ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse
ENV RUST_BACKTRACE=1
ENV RUST_LOG=debug

# Accept DATABASE_URL as build argument
ARG DATABASE_URL
ENV DATABASE_URL=${DATABASE_URL:-postgres://pessoa_user:dev_password_123@db:5432/pessoa_db}

WORKDIR /app

# Install all development dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        libssl-dev \
        ca-certificates \
        lld \
        # PDF processing tools
        poppler-utils \
        # Network debugging tools
        net-tools \
        iputils-ping \
        # PostgreSQL client for debugging
        postgresql-client \
        # JSON tools for debugging
        jq \
        # Text editor for quick fixes
        nano \
        vim \
        # Git for version control in container
        git \
        # Process monitoring
        procps \
        htop \
        # Dependencies for NodeSource repository
        curl \
        gnupg && \
    # Add NodeSource repository for Node.js 22.x
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    # Install Node.js and npm from NodeSource
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Install global Node packages
RUN npm install -g @anthropic-ai/claude-code @google/gemini-cli

# Install Rust development tools
RUN cargo install cargo-watch --locked && \
    cargo install sqlx-cli --version=0.7.4 --features rustls,postgres --no-default-features --locked

# Copy only Cargo files for potential future use
# But skip pre-building since we'll use cargo-watch with mounted source
COPY Cargo.toml Cargo.lock ./

# Copy the .sqlx directory for offline mode
COPY .sqlx ./.sqlx/

# Set SQLX to offline mode for development
ENV SQLX_OFFLINE=true

# Create uploads directory
RUN mkdir -p uploads/scripts

# Copy entrypoint and other scripts
COPY docker-entrypoint.sh execute_sql.sh json_to_db.sh init-claude.sh ./
RUN chmod +x docker-entrypoint.sh execute_sql.sh json_to_db.sh init-claude.sh

# The source code will be mounted as a volume in docker-compose.dev.yml
# This allows for hot reloading without rebuilding the image

# Expose the backend port
EXPOSE 3000

# Use cargo-watch for hot reloading
# -x run: Execute 'cargo run' on changes
# -w src: Watch the src directory
# -w Cargo.toml: Also watch Cargo.toml
# -i target: Ignore target directory
# -c: Clear screen before each run
# -d 2: Delay 2 seconds before restarting (debounce)
CMD ["cargo", "watch", "-x", "run --bin backend", "-w", "src", "-w", "Cargo.toml", "-i", "target", "-c", "-d", "2"]