# Use a specific Node LTS version on Alpine for smaller image size
FROM node:20-alpine AS builder

# Declare build arguments received from docker-compose
ARG VITE_API_BASE_URL
ARG VITE_WS_BASE_URL
# Set these ARGs as ENV variables so they are available to the CMD
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_WS_BASE_URL=${VITE_WS_BASE_URL}

ENV NODE_ENV=development

WORKDIR /app

# Copy package files first for better layer caching
COPY package.json package-lock.json ./

# Install dependencies with caching
RUN --mount=type=cache,target=/root/.npm \
    npm ci --prefer-offline --no-audit
# Kein COPY, das wird über Bind-Mount eingebunden
CMD ["npm", "run", "dev"]
