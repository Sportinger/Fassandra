# Use a specific Node LTS version on Alpine for smaller image size
FROM node:20-alpine AS builder

# Declare build arguments received from docker-compose
ARG VITE_API_BASE_URL
ARG VITE_WS_BASE_URL

WORKDIR /app

# Copy package files first for better layer caching
COPY package.json package-lock.json ./

# Install dependencies with caching
RUN --mount=type=cache,target=/root/.npm \
    npm ci --prefer-offline --no-audit
RUN npm rebuild

# Copy the rest of the application code
COPY . .

# Build the application with caching
RUN --mount=type=cache,target=/app/node_modules/.cache \
    VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_WS_BASE_URL=${VITE_WS_BASE_URL} \
    npm run build

# --- Production Stage ---
FROM nginx:stable-alpine

# Install openssl for certificate generation if needed
RUN apk add --no-cache openssl

# Copy built assets from the builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy HTTPS nginx configuration
COPY nginx-https.conf /etc/nginx/conf.d/default.conf

# Create SSL directories
RUN mkdir -p /etc/ssl/certs /etc/ssl/private

# Copy SSL certificates (these should be mounted or generated)
# Note: In production, these should be properly managed certificates
COPY ssl/certs/server.crt /etc/ssl/certs/
COPY ssl/private/server.key /etc/ssl/private/

# Set proper permissions for SSL files
RUN chmod 644 /etc/ssl/certs/server.crt && \
    chmod 600 /etc/ssl/private/server.key

# Expose both HTTP (for redirect) and HTTPS ports
EXPOSE 80 443

# Command to run Nginx in the foreground
CMD ["nginx", "-g", "daemon off;"] 