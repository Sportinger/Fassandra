:80 {
    root * /srv

    # Serve version.json at /version with JSON content type
    handle /version {
        header Content-Type application/json
        rewrite * /version.json
        file_server
    }

    # Handle all other requests
    handle {
        try_files {path} /index.html
        file_server
    }

    # Enable gzip compression
    encode gzip

    # Cache strategy: no-store for HTML/SPA shell; long cache for hashed assets
    @static {
        path *.js *.css *.png *.jpg *.jpeg *.svg *.gif *.webp *.ico *.woff2 *.woff *.ttf
    }
    header @static {
        Cache-Control "public, max-age=31536000, immutable"
    }

    @html {
        not path *.js *.css *.png *.jpg *.jpeg *.svg *.gif *.webp *.ico *.woff2 *.woff *.ttf
    }
    header @html {
        Cache-Control "no-store"
    }

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        -Server
    }
}
