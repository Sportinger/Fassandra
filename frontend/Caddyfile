:80 {
    root * /srv
    file_server
    try_files {path} /index.html
    
    # Enable gzip compression
    encode gzip
    
    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        -Server
    }
}