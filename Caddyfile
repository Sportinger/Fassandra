# Caddyfile for fassandra.de production deployment
{
    email admin@fassandra.de
}

www.fassandra.de {
    redir https://fassandra.de{uri}
}

fassandra.de {
    # Backend API - handle API routes first
    handle /api/* {
        reverse_proxy backend:3000 {
            # Timeouts for long-lived WebSocket connections
            transport http {
                # Force HTTP/1.1 for upstream to avoid any h2 upgrade quirks (Firefox)
                versions 1.1
                read_timeout 24h
                write_timeout 24h
                dial_timeout 30s
                # No response header timeout for upgraded connections
            }
        }
    }

    # Health check endpoint
    handle /health {
        reverse_proxy backend:3000
    }
    
    # Login endpoint (no /api prefix)
    handle /login {
        reverse_proxy backend:3000
    }
    
    # Google login endpoint
    handle /login/google {
        reverse_proxy backend:3000
    }
    
    # Register endpoint (no /api prefix)
    handle /register {
        reverse_proxy backend:3000
    }

    # Frontend - proxy to frontend container
    handle {
        reverse_proxy frontend:80
    }

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        -Server
    }

    # Gzip compression (excluding WebSocket to prevent binary corruption)
    encode {
        gzip
        match {
            header Content-Type text/*
            header Content-Type application/json
            header Content-Type application/javascript
            header Content-Type application/xml
        }
    }

    # Request body size limit for large Yjs updates
    request_body {
        max_size 50MB
    }

    # Logging
    log {
        output file /var/log/caddy/access.log
        format json
    }
}
