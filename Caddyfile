# Caddyfile for fassandra.de production deployment
{
    email admin@fassandra.de
}

www.fassandra.de {
    redir https://fassandra.de{uri}
}

# Development environment
dev.fassandra.de {
    # Backend API
    handle /api/* {
        reverse_proxy dev-backend:3000 {
            transport http {
                versions 1.1
                read_timeout 24h
                write_timeout 24h
                dial_timeout 30s
            }
        }
    }

    # Health check endpoint
    handle /health {
        reverse_proxy dev-backend:3000
    }

    # Login endpoint
    handle /login {
        reverse_proxy dev-backend:3000
    }

    # Google login endpoint
    handle /login/google {
        reverse_proxy dev-backend:3000
    }

    # Register endpoint
    handle /register {
        reverse_proxy dev-backend:3000
    }

    # Frontend
    handle {
        reverse_proxy dev-frontend:80
    }

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        -Server
    }

    encode zstd gzip

    request_body {
        max_size 50MB
    }

    log {
        output file /var/log/caddy/dev-access.log
        format json
    }
}

fassandra.de {
    # Backend API - handle API routes first
    handle /api/* {
        reverse_proxy backend:3000 {
            # Timeouts for long-lived WebSocket connections
            transport http {
                # Force HTTP/1.1 for upstream to avoid any h2 upgrade quirks (Firefox)
                versions 1.1
                read_timeout 24h
                write_timeout 24h
                dial_timeout 30s
                # No response header timeout for upgraded connections
            }
        }
    }

    # Health check endpoint
    handle /health {
        reverse_proxy backend:3000
    }
    
    # Login endpoint (no /api prefix)
    handle /login {
        reverse_proxy backend:3000
    }
    
    # Google login endpoint
    handle /login/google {
        reverse_proxy backend:3000
    }
    
    # Register endpoint (no /api prefix)
    handle /register {
        reverse_proxy backend:3000
    }

    # Frontend - proxy to frontend container
    
    # Optional: explicit wipe endpoint (manual use only)
    @wipe_origin path /_wipe
    handle @wipe_origin {
        header {
            # One-shot wipe: call https://fassandra.de/_wipe from a tab, then reload
            Clear-Site-Data "\"cache\", \"cookies\", \"storage\", \"executionContexts\""
        }
        respond "" 204
    }

    # Default: serve frontend without wiping site data on every request
    handle {
        reverse_proxy frontend:80
    }

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        -Server
    }

    # Compression
    encode zstd gzip

    # Request body size limit for large Yjs updates
    request_body {
        max_size 50MB
    }

    # Logging
    log {
        output file /var/log/caddy/access.log
        format json
    }
}
