# Fassandra Environment Configuration Example
# Copy this file to .env.prod and fill in your actual values

# Common Placeholders
YOUR_DOMAIN=your-domain.com
YOUR_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
YOUR_SECURE_PASSWORD=your_secure_password
YOUR_JWT_SECRET_KEY=your_jwt_secret_key_here
YOUR_ADMIN_PASSWORD=your_admin_password
YOUR_PGADMIN_PASSWORD=your_pgadmin_password
YOUR_GEMINI_API_KEY=your_gemini_api_key
YOUR_DEEPGRAM_API_KEY=your_deepgram_api_key

# Application Configuration
FRONTEND_PORT=80
BACKEND_PORT=3000
DATABASE_PORT=5432
PGADMIN_PORT=5050

# No need to change below this line, usually
APP_HOSTNAME=$YOUR_DOMAIN
APP_DOMAIN=$YOUR_DOMAIN

# API URLs
VITE_API_BASE_URL=https://$YOUR_DOMAIN
VITE_WS_BASE_URL=wss://$YOUR_DOMAIN/api/collab
VITE_LOG_LEVEL=WARN
VITE_YJS_DEBUG=false

# CORS Origins (includes Capacitor/mobile app support)
# Multiple origins separated by commas
CORS_ORIGINS=https://localhost,https://$YOUR_DOMAIN,https://www.$YOUR_DOMAIN,capacitor://localhost,http://localhost
ALLOWED_ORIGINS=https://localhost,https://$YOUR_DOMAIN,https://www.$YOUR_DOMAIN,capacitor://localhost,ionic://localhost,http://localhost

# Database Configuration
DATABASE_URL=postgresql://postgres:$YOUR_SECURE_PASSWORD@db:$DATABASE_PORT/pessoa_db
POSTGRES_DB=pessoa_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=$YOUR_SECURE_PASSWORD

# Authentication
JWT_SECRET=$YOUR_JWT_SECRET_KEY
ADMIN_EMAIL=admin@$YOUR_DOMAIN
ADMIN_USERNAME=admin
ADMIN_PASSWORD=$YOUR_ADMIN_PASSWORD

# PgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@$YOUR_DOMAIN
PGADMIN_DEFAULT_PASSWORD=$YOUR_PGADMIN_PASSWORD

# AI Integration
GEMINI_API_KEY=$YOUR_GEMINI_API_KEY
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro-latest:generateContent

# Environment
ENVIRONMENT=production
RUST_ENV=production
PRODUCTION=true
COOKIE_DOMAIN=.$YOUR_DOMAIN
RUST_LOG=info

# Auto-Follow / ASR Configuration
ASR_PROVIDER=deepgram
ASR_LANGUAGE=de
ASR_SAMPLE_RATE=48000
DEEPGRAM_API_KEY=$YOUR_DEEPGRAM_API_KEY

# Container prefix
CONTAINER_PREFIX=mylayer_

# OAuth Configuration
# You can set one or multiple client IDs (comma-separated)
# If both GOOGLE_CLIENT_IDS and GOOGLE_CLIENT_ID are set, GOOGLE_CLIENT_IDS takes precedence
GOOGLE_CLIENT_ID=$YOUR_GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_IDS=client_id_1.apps.googleusercontent.com,client_id_2.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=$YOUR_GOOGLE_CLIENT_ID

# YJS WebSocket Sync
YJS_WS_SYNC=on
