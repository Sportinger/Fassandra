# Fassandra Environment Configuration Example
# Copy this file to .env.prod and fill in your actual values

# Application Configuration
APP_HOSTNAME=your-domain.com
APP_DOMAIN=your-domain.com
FRONTEND_PORT=80
BACKEND_PORT=3000
DATABASE_PORT=5432
PGADMIN_PORT=5050

# API URLs
VITE_API_BASE_URL=https://your-domain.com
VITE_WS_BASE_URL=wss://your-domain.com/api/collab
VITE_LOG_LEVEL=WARN
VITE_YJS_DEBUG=false

# CORS Origins (includes Capacitor/mobile app support)
# Multiple origins separated by commas
CORS_ORIGINS=https://localhost,https://your-domain.com,https://www.your-domain.com,capacitor://localhost,http://localhost
ALLOWED_ORIGINS=https://localhost,https://your-domain.com,https://www.your-domain.com,capacitor://localhost,ionic://localhost,http://localhost

# Database Configuration
DATABASE_URL=postgresql://postgres:your_secure_password@db:5432/pessoa_db
POSTGRES_DB=pessoa_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password

# Authentication
JWT_SECRET=your_jwt_secret_key_here
ADMIN_EMAIL=admin@your-domain.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password

# PgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@your-domain.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password

# AI Integration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro-latest:generateContent

# Environment
ENVIRONMENT=production
RUST_ENV=production
PRODUCTION=true
COOKIE_DOMAIN=.your-domain.com
RUST_LOG=info

# Auto-Follow / ASR Configuration
ASR_PROVIDER=deepgram
ASR_LANGUAGE=de
ASR_SAMPLE_RATE=48000
DEEPGRAM_API_KEY=your_deepgram_api_key

# Anthropic API Configuration (for AI Format feature)
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_RATE_LIMIT_MS=2000

# Container prefix
CONTAINER_PREFIX=mylayer_

# OAuth Configuration
# You can set one or multiple client IDs (comma-separated)
# If both GOOGLE_CLIENT_IDS and GOOGLE_CLIENT_ID are set, GOOGLE_CLIENT_IDS takes precedence
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_IDS=client_id_1.apps.googleusercontent.com,client_id_2.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# YJS WebSocket Sync
YJS_WS_SYNC=on
