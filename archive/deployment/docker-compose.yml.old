# docker-compose.yml

services:
  db:
    image: postgres:15 # Use a specific Postgres version
    container_name: pessoa_db
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD} # Loaded from .env
      POSTGRES_DB: ${POSTGRES_DB}
    volumes:
      - pgdata:/var/lib/postgresql/data # Persist database data
    ports:
      - "5432:5432" # Expose port for potential direct access (optional)
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 10s
      timeout: 5s
      retries: 5

  backend:
    container_name: pessoa_backend
    build:
      context: . # Using root project directory as context
      dockerfile: backend/Dockerfile # Updated path to Dockerfile
    environment:
      DATABASE_URL: ${DATABASE_URL} # Loaded from .env
      # Pass JWT secret via env
      JWT_SECRET: ${JWT_SECRET} # Loaded from .env
      # Pass Gemini API keys
      GEMINI_API_KEY: ${GEMINI_API_KEY} # Loaded from .env
      GEMINI_API_URL: ${GEMINI_API_URL} # Loaded from .env
      # Pass other backend config via env
      BACKEND_PORT: ${BACKEND_PORT:-3001} # Default if not set in .env
      APP_DOMAIN: ${APP_DOMAIN:-arnodell.hopto.org:8080}
      ALLOWED_ORIGINS: ${CORS_ORIGINS:-http://localhost:8080,http://127.0.0.1:8080,http://${APP_DOMAIN}}
      DB_MAX_CONNECTIONS: ${DB_MAX_CONNECTIONS:-10}
    ports:
      - "${BACKEND_PORT:-3001}:${BACKEND_PORT:-3001}" # Map host port from .env to container port
    depends_on:
      db:
        condition: service_healthy # Wait for db to be ready
    # If you need hot-reloading for development, you might add a volume:
    # volumes:
    #   - ./backend:/usr/src/app # Mount local code
    #   - /usr/src/app/target # Exclude target directory from volume mount
    # command: cargo watch -x run # Command to run with hot-reloading (needs cargo-watch)

  frontend:
    container_name: pessoa_frontend
    build:
      context: ./frontend # Path to frontend Dockerfile context
      dockerfile: Dockerfile
      # Pass the backend URL as a build argument
      args:
        VITE_API_BASE_URL: ${VITE_API_BASE_URL}
        VITE_WS_BASE_URL: ${VITE_WS_BASE_URL}
    ports:
      - "${FRONTEND_PORT:-8080}:80" # Map host port from .env to container port 80 (nginx default)
    depends_on:
      - backend # Optional: ensure backend starts first, though frontend usually handles unavailable API

volumes:
  pgdata: # Define the named volume for postgres data persistence
