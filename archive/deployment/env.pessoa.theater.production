# =================================================================
# PESSOA.THEATER PRODUCTION ENVIRONMENT CONFIGURATION
# Single production environment - no dev/staging
# =================================================================

# 🌐 PRODUCTION DOMAIN CONFIGURATION
APP_HOSTNAME=pessoa.theater
BACKEND_PORT=3001
FRONTEND_PORT=80           # HTTP port (redirects to HTTPS)
FRONTEND_HTTPS_PORT=443    # Standard HTTPS port (no :443 needed in URL)
DB_PORT=5432
CONTAINER_PREFIX=prod_     # Production prefix

# 🐳 DOCKER REGISTRY CONFIGURATION
DOCKER_REGISTRY=ghcr.io/sportinger  # Your GitHub username
IMAGE_TAG=latest

# 🔐 SSL CERTIFICATES (Let's Encrypt paths for pessoa.theater)
SSL_CERT_PATH=/etc/letsencrypt/live/pessoa.theater/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/pessoa.theater/privkey.pem

# =================================================================
# INTERNAL CONFIGURATION
# =================================================================
BACKEND_INTERNAL_PORT=3001
FRONTEND_INTERNAL_PORT=80
DB_INTERNAL_PORT=5432

# 🗄️ DATABASE CONFIGURATION
POSTGRES_USER=pessoa_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_123!  # 🔒 Update for production
POSTGRES_DB=pessoa_db
DATABASE_URL=postgres://pessoa_user:CHANGE_THIS_SECURE_PASSWORD_123!@db:5432/pessoa_db

# 🔐 SECURITY CONFIGURATION
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING_FOR_PRODUCTION_AT_LEAST_32_CHARS!  # 🔒 Update for production

# 🌍 API CONFIGURATION
APP_DOMAIN=${APP_HOSTNAME}
# CORS origins - only pessoa.theater
CORS_ORIGINS=https://pessoa.theater,https://www.pessoa.theater,http://pessoa.theater
ALLOWED_ORIGINS=${CORS_ORIGINS}
DB_MAX_CONNECTIONS=20

# 🎨 FRONTEND CONFIGURATION
VITE_API_BASE_URL=https://pessoa.theater
VITE_WS_BASE_URL=wss://pessoa.theater/api/collab

# 🤖 AI INTEGRATION
GEMINI_API_KEY=AIzaSyCGkJudo4e0YEgZZKQ8xXTPBOTB3cQCY_g  # 🔒 Consider using your own key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro-latest:generateContent

# 🛠️ PGADMIN CONFIGURATION  
PGADMIN_DEFAULT_EMAIL=admin@pessoa.theater
PGADMIN_DEFAULT_PASSWORD=CHANGE_THIS_SECURE_PGADMIN_PASSWORD!  # 🔒 Update for production
PGADMIN_INTERNAL_PORT=80
PGADMIN_PORT=5050

# 📊 LOGGING CONFIGURATION
RUST_LOG=info,backend=info

# =================================================================
# 🚀 DEPLOYMENT NOTES
# =================================================================
# 1. Update passwords/secrets marked with 🔒
# 2. Ensure SSL certificates exist at specified paths
# 3. DNS should point pessoa.theater to your Hetzner server IP
# 4. Use docker-compose.hetzner-github-actions.yml for deployment
# 5. Access: https://pessoa.theater (no port needed)
# 6. pgAdmin: https://pessoa.theater:5050
# ================================================================= 