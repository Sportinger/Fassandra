# Production Environment for Hetzner Server
# Copy this to .env on your Hetzner server and customize the values

# Domain configuration (CHANGE THESE FOR YOUR HETZNER SERVER)
APP_HOSTNAME=your-domain.com  # Your actual domain
BACKEND_PORT=3001
FRONTEND_PORT=80              # Standard HTTP port  
FRONTEND_HTTPS_PORT=443       # Standard HTTPS port
DB_PORT=5432                  # Standard PostgreSQL port (internal)
CONTAINER_PREFIX=prod_

# Container Registry Configuration
DOCKER_REGISTRY=ghcr.io/your-username  # GitHub Container Registry
IMAGE_TAG=latest

# SSL Certificate Paths on Hetzner Server
SSL_CERT_PATH=/etc/ssl/certs/your-domain.crt
SSL_KEY_PATH=/etc/ssl/private/your-domain.key

## Internal configurations (usually no changes needed)
BACKEND_INTERNAL_PORT=3001
FRONTEND_INTERNAL_PORT=80
DB_INTERNAL_PORT=5432

# Database configuration (CHANGE PASSWORDS!)
POSTGRES_USER=pessoa_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PRODUCTION_PASSWORD
POSTGRES_DB=pessoa_db
DATABASE_URL=postgres://pessoa_user:CHANGE_THIS_SECURE_PRODUCTION_PASSWORD@db:5432/pessoa_db

# Security (GENERATE SECURE VALUES!)
JWT_SECRET=GENERATE_SECURE_JWT_SECRET_FOR_PRODUCTION_MINIMUM_32_CHARS

# API configuration
APP_DOMAIN=${APP_HOSTNAME}
CORS_ORIGINS=https://${APP_HOSTNAME},https://www.${APP_HOSTNAME}
ALLOWED_ORIGINS=${CORS_ORIGINS}
DB_MAX_CONNECTIONS=20

# Frontend configuration (these get baked into the frontend build)
VITE_API_BASE_URL=https://${APP_HOSTNAME}/api
VITE_WS_BASE_URL=wss://${APP_HOSTNAME}/api/collab

# AI Integration (USE YOUR OWN API KEY!)
GEMINI_API_KEY=YOUR_PRODUCTION_GEMINI_API_KEY
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro-latest:generateContent

# pgAdmin configuration (CHANGE CREDENTIALS!)
PGADMIN_DEFAULT_EMAIL=admin@your-domain.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_THIS_SECURE_PGADMIN_PASSWORD
PGADMIN_INTERNAL_PORT=80
PGADMIN_PORT=5050

# Logging
RUST_LOG=info,backend=info 