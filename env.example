# =================================================================
# 🏠 PESSOA LOCAL DEVELOPMENT ENVIRONMENT
# Copy this file to .env and customize for your setup
# =================================================================

# 🌐 LOCAL CONFIGURATION
APP_HOSTNAME=192.168.2.111        # Your local IP address
BACKEND_PORT=3000
FRONTEND_PORT=8080                 # HTTP port
FRONTEND_HTTPS_PORT=8443          # Secure HTTPS port
CONTAINER_PREFIX=dev_

# 🗄️ DATABASE
POSTGRES_USER=pessoa_user
POSTGRES_PASSWORD=dev_password_123  # CHANGE FOR PRODUCTION!
POSTGRES_DB=pessoa_db
DATABASE_URL=postgres://pessoa_user:dev_password_123@db:5432/pessoa_db

# 🔐 SECURITY - CRITICAL: ROTATE ALL SECRETS!
# Generate new JWT_SECRET with: openssl rand -base64 32
JWT_SECRET=JDrpHPHR16C6lgljx5VEQmf+Mzei3foIFcWKC1sSFFw=

# 🔒 SECURITY HEADERS CONFIGURATION
# Content Security Policy - adjust for your needs (stricter for production)
CSP_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' wss: ws:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# HSTS (HTTP Strict Transport Security) Configuration
HSTS_MAX_AGE=31536000                    # 1 year in seconds
HSTS_INCLUDE_SUBDOMAINS=true             # Include subdomains in HSTS

# Additional Security Headers
X_FRAME_OPTIONS=DENY                     # Options: DENY, SAMEORIGIN, ALLOW-FROM
REFERRER_POLICY=strict-origin-when-cross-origin  # Control referrer information
PERMISSIONS_POLICY=geolocation=(), microphone=(), camera=()  # Browser feature permissions

# 🛡️ RATE LIMITING & IP VALIDATION
# CRITICAL: Only enable TRUST_PROXY in production behind trusted reverse proxies (nginx, cloudflare, etc.)
# When false: Uses direct connection IP (development/testing)
# When true: Trusts X-Forwarded-For header with validation (production with reverse proxy)
TRUST_PROXY=false                        # Set to 'true' only in production behind trusted proxies

# 🌍 API CONFIGURATION
APP_DOMAIN=192.168.2.111:8443
ALLOWED_ORIGINS=https://192.168.2.111:8443,http://192.168.2.111:8080,http://localhost:8080,https://localhost:8443
DB_MAX_CONNECTIONS=10

# 🎨 FRONTEND
# VITE_API_BASE_URL should be empty to use vite proxy for backend calls
VITE_API_BASE_URL=""
VITE_WS_BASE_URL=wss://192.168.2.111:8443/api/collab

# 🤖 AI INTEGRATION - GEMINI API (CONFIGURED!)
# Get your own key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSyCGkJudo4e0YEgZZKQ8xXTPBOTB3cQCY_g
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro-latest:generateContent

# 🛠️ PGADMIN
PGADMIN_DEFAULT_EMAIL=admin@pessoa.local
PGADMIN_DEFAULT_PASSWORD=dev_pgadmin_password  # CHANGE FOR PRODUCTION!
PGADMIN_PORT=5050

# 📊 LOGGING
RUST_LOG=info,backend=debug 
# 👤 ADMIN USER SETUP (for dev environment)
ADMIN_EMAIL=admin@pessoa.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dev_admin_password
ADMIN_PLACEHOLDER_HASH=$$2b$$10$$placeholder_hash_for_dev_setup_only

RUST_LOG=info,backend=debug

# 🔍 WEB SEARCH API KEYS (for MCP web-search server)
# Get API keys from respective providers:
# Brave: https://brave.com/search/api/
# OpenAI: https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/
# Google: https://console.developers.google.com/
# OpenRouter: https://openrouter.ai/keys
# xAI: https://console.x.ai/
BRAVE_API_KEY=your_brave_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
XAI_API_KEY=your_xai_api_key_here
