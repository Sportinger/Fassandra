# Command line parameters will be passed to docker compose build

# Ensure .env exists in the project root and source it for DATABASE_URL
if [ ! -f ".env" ]; then
    echo "Error: .env is missing in the project root. Please create it and add the required secrets, including DATABASE_URL."
    exit 1
fi
set -o allexport
source .env
set +o allexport

if [ -z "$DATABASE_URL" ]; then
    echo "Error: DATABASE_URL is not set in .env. Please add it."
    exit 1
fi

