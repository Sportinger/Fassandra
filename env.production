# =================================================================
# 🚀 PESSOA PRODUCTION ENVIRONMENT (Hetzner)
# Copy this file to .env on your production server
# =================================================================

# 🌐 PRODUCTION CONFIGURATION
APP_HOSTNAME=pessoa.theater
CONTAINER_PREFIX=prod_

# 🐳 DOCKER REGISTRY (for pre-built images)
DOCKER_REGISTRY=ghcr.io/sportinger  # Your GitHub username
IMAGE_TAG=latest

# 🔐 SSL CERTIFICATES (Let's Encrypt paths)
SSL_CERT_PATH=/etc/letsencrypt/live/pessoa.theater/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/pessoa.theater/privkey.pem

# 🗄️ DATABASE
POSTGRES_USER=pessoa_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_123!  # 🔒 UPDATE FOR PRODUCTION
POSTGRES_DB=pessoa_db
DATABASE_URL=postgres://pessoa_user:CHANGE_THIS_SECURE_PASSWORD_123!@db:5432/pessoa_db

# 🔐 SECURITY
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING_FOR_PRODUCTION_AT_LEAST_32_CHARS!  # 🔒 UPDATE FOR PRODUCTION

# 🌍 API CONFIGURATION
APP_DOMAIN=pessoa.theater
ALLOWED_ORIGINS=https://pessoa.theater,https://www.pessoa.theater
DB_MAX_CONNECTIONS=20

# 🎨 FRONTEND
VITE_API_BASE_URL=https://pessoa.theater
VITE_WS_BASE_URL=wss://pessoa.theater/api/collab

# 🤖 AI INTEGRATION
GEMINI_API_KEY=your_production_gemini_api_key  # 🔒 UPDATE FOR PRODUCTION
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro-latest:generateContent

# 🛠️ PGADMIN
PGADMIN_DEFAULT_EMAIL=admin@pessoa.theater
PGADMIN_DEFAULT_PASSWORD=CHANGE_THIS_SECURE_PGADMIN_PASSWORD!  # 🔒 UPDATE FOR PRODUCTION
PGADMIN_PORT=5050

# 📊 LOGGING
RUST_LOG=info,backend=info 