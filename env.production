# =================================================================
# 🚀 PESSOA PRODUCTION ENVIRONMENT (Hetzner)
# 
# ⚠️  SECURITY NOTICE:
# This file contains NON-SECRET configuration only.
# NEVER put real secrets in this file!
# Use system environment variables for secrets in production.
# =================================================================

# 🌐 PRODUCTION CONFIGURATION (Non-secrets)
APP_HOSTNAME=pessoa.theater
CONTAINER_PREFIX=prod_
APP_DOMAIN=pessoa.theater
ALLOWED_ORIGINS=https://pessoa.theater,https://www.pessoa.theater
DB_MAX_CONNECTIONS=20
RUST_LOG=info,backend=info

# 🐳 DOCKER REGISTRY (for pre-built images)
DOCKER_REGISTRY=ghcr.io/sportinger
IMAGE_TAG=latest

# 🔐 SSL CERTIFICATES (Let's Encrypt paths)
SSL_CERT_PATH=/etc/letsencrypt/live/pessoa.theater/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/pessoa.theater/privkey.pem

# 🎨 FRONTEND CONFIGURATION
VITE_API_BASE_URL=https://pessoa.theater
VITE_WS_BASE_URL=wss://pessoa.theater/api/collab

# 🤖 AI INTEGRATION (URLs only)
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro-latest:generateContent

# 🛠️ PGADMIN CONFIGURATION
PGADMIN_DEFAULT_EMAIL=admin@pessoa.theater
PGADMIN_PORT=5050

# =================================================================
# 🔒 SECRETS (Set these as system environment variables)
# =================================================================
# Don't put real values here! Use system environment variables:
#
# export DATABASE_URL="postgres://pessoa_user:REAL_PASSWORD@db:5432/pessoa_db"
# export JWT_SECRET="REAL_LONG_RANDOM_STRING_FOR_PRODUCTION"
# export GEMINI_API_KEY="your_real_gemini_api_key"
# export PGADMIN_DEFAULT_PASSWORD="real_secure_pgadmin_password"
# export POSTGRES_PASSWORD="real_secure_db_password"
#
# These will override any values from this file.
# =================================================================

# 🗄️ DATABASE (Development/Template values only)
POSTGRES_USER=pessoa_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_123!
POSTGRES_DB=pessoa_db
DATABASE_URL=postgres://pessoa_user:CHANGE_THIS_SECURE_PASSWORD_123!@db:5432/pessoa_db

# 🔐 SECURITY (Template values only)
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING_FOR_PRODUCTION_AT_LEAST_32_CHARS!

# 🤖 AI INTEGRATION (Template values only)
GEMINI_API_KEY=your_production_gemini_api_key

# 🛠️ PGADMIN (Template values only)
PGADMIN_DEFAULT_PASSWORD=CHANGE_THIS_SECURE_PGADMIN_PASSWORD! 